# Salin file ini menjadi .env.local
# (Opsional untuk login cepat di development: tanpa file ini pun tombol login cepat tetap jalan.)

DATABASE_URL=postgresql://postgres:password@localhost:5432/kerjakita
# Isi dengan string acak minimal 32 karakter
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# Set true jika PostgreSQL hosting mewajibkan SSL
PGSSL=false
